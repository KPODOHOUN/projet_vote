# SHADOMA — variables d'environnement (modèle, aucune valeur réelle).
# Copier en `.env` à la racine pour le développement local. En production,
# chaque valeur vient du gestionnaire de secrets de l'hébergeur.
# Source de vérité côté API : apps/api/src/config/env.ts (validation zod).
# En NODE_ENV=production, l'API refuse de démarrer si un secret garde sa valeur
# « dev-only-* », si API_PAYMENT_DEMO_MODE=true, ou si MAIL_RESEND_API_KEY manque.

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/votezpro
# Base jetable pour `npm test` (apps/api) et les e2e (apps/web).
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5433/votezpro_test
APP_PUBLIC_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
# Optionnel : stockage partagé du throttle (sinon mémoire du processus).
API_REDIS_URL=

# ── Secrets applicatifs (32 caractères minimum, générés, jamais partagés) ─
API_JWT_SECRET=<32+ caractères aléatoires>
API_JWT_EXPIRES_IN_SECONDS=900
API_REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
API_ORGANIZER_SECRET_KEY=<32+ caractères aléatoires>
API_VAULT_SECRET_KEY=<32+ caractères aléatoires>
API_MAINTENANCE_CRON_SECRET=<32+ caractères aléatoires, partagé avec le worker cron>
API_MAINTENANCE_CRON_MAX_SKEW_SECONDS=900
API_OPS_TOKEN=<32+ caractères aléatoires>

# ── Paiements (PSP) ─────────────────────────────────────────────────────
# Jamais true en production : confirme les paiements sans PSP.
API_PAYMENT_DEMO_MODE=false
DEFAULT_PSP_PROVIDER=FEEXPAY
PSP_SUPPORTED_OPERATORS=mtn,moov,orange
PSP_SUPPORTED_COUNTRY_CODES=229,225,228,221,227,226,223,224
PLATFORM_DEFAULT_COUNTRY_CODE=229
PSP_STATUS_PULL_MIN_INTERVAL_MS=8000
FEEXPAY_BASE_URL=https://api.feexpay.me
# Production : préfixe fp_ (LIVE) ou test_ (SANDBOX).
FEEXPAY_API_KEY=<clé FeexPay>
FEEXPAY_SHOP_ID=<identifiant boutique FeexPay>
FEEXPAY_HTTP_TIMEOUT_MS=8000
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com/v1
FEDAPAY_API_KEY=<clé FedaPay>
FEDAPAY_HTTP_TIMEOUT_MS=8000
KKIAPAY_BASE_URL=https://api-sandbox.kkiapay.me
KKIAPAY_PUBLIC_KEY=<clé publique Kkiapay>
KKIAPAY_PRIVATE_KEY=<clé privée Kkiapay>
KKIAPAY_SECRET_KEY=<secret Kkiapay>
KKIAPAY_HTTP_TIMEOUT_MS=8000
PLATFORM_PAYOUT_NETWORK=MTN
PLATFORM_PAYOUT_ACCOUNT=<numéro du compte plateforme>

# ── E-mail (Resend) — obligatoire en production ─────────────────────────
MAIL_RESEND_API_KEY=
MAIL_FROM=SHADOMA Votes <noreply@example.com>
MAIL_ADMIN_EXTRA_RECIPIENTS=

# ── Upload photos (Cloudinary, upload signé) ────────────────────────────
# Facultatif : sans ces trois valeurs (et NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME),
# les images importées sont réduites dans le navigateur puis stockées en base
# (table StoredImage) et servies par l'API. Cloudinary apporte le recadrage à la volée.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OAuth (un fournisseur n'apparaît que si id ET secret sont définis) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/oauth/callback/google
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/oauth/callback/facebook

# ── Observabilité et alertes ────────────────────────────────────────────
API_SENTRY_DSN=
API_SENTRY_TRACES_SAMPLE_RATE=0.1
PLATFORM_ALERT_WEBHOOK_URL=

# ── Assistant (optionnel ; sans clé, le widget est masqué) ──────────────
OPENAI_API_KEY=
# Plafonds journaliers (global et par IP). Partagés entre instances si
# API_REDIS_URL est défini ; sinon comptés par instance (plafond multiplié).
CHAT_DAILY_LIMIT=500
CHAT_DAILY_LIMIT_PER_IP=30

# ── Seed ────────────────────────────────────────────────────────────────
SEED_PLATFORM_ADMIN_PASSWORD=<mot de passe fort, changé après le premier login>

# ── Front (apps/web) ────────────────────────────────────────────────────
# Les variables NEXT_PUBLIC_* et CSP_REPORT_URI sont figées au build :
# changer leur valeur impose de reconstruire le front.
# Origine de l'API pour le proxy /api/v1 côté serveur Next.
API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
# Slug d'un concours de démonstration à lier depuis la Home (optionnel).
NEXT_PUBLIC_DEMO_EVENT_SLUG=
# true uniquement en démo : ouvre le formulaire d'achat de billets.
NEXT_PUBLIC_TICKET_SALES_OPEN=false
# Optionnel : collecteur des violations de la CSP Report-Only (URL https).
CSP_REPORT_URI=
