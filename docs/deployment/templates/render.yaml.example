# Modèle non testé. Copier en render.yaml à la racine (exclu par le .gitignore).
# Aucun hébergeur n'est retenu : ce fichier illustre un service API toujours actif
# (pas de mise en veille : le rapprochement des paiements et les webhooks en dépendent).
services:
  - type: web
    name: shadoma-api
    runtime: docker
    dockerfilePath: ./apps/api/Dockerfile
    dockerContext: .
    plan: starter            # un plan sans mise en veille
    healthCheckPath: /api/v1/health
    preDeployCommand: npx prisma migrate deploy --schema packages/db/prisma/schema.prisma
    envVars:
      - key: NODE_ENV
        value: production
      # Migrations faites par preDeployCommand : ne pas les relancer au démarrage.
      - key: RUN_MIGRATIONS_ON_START
        value: "false"
      # Une seule instance sans Redis ; sinon définir API_REDIS_URL.
      - key: API_SINGLE_INSTANCE
        value: "true"
      # IP des visiteurs relayée par le front : même valeur que EDGE_PROXY_SECRET sur Vercel
      # (openssl rand -hex 32). Obligatoire en production.
      - key: API_EDGE_PROXY_SECRET
        sync: false
      - key: DATABASE_URL
        sync: false
      - key: API_JWT_SECRET
        sync: false
      - key: API_ORGANIZER_SECRET_KEY
        sync: false
      - key: API_VAULT_SECRET_KEY
        sync: false
      - key: API_MAINTENANCE_CRON_SECRET
        sync: false
      - key: API_OPS_TOKEN
        sync: false
      - key: MAIL_RESEND_API_KEY
        sync: false
      - key: APP_PUBLIC_URL
        sync: false
      - key: API_CORS_ORIGINS
        sync: false
      # Clés PSP, Cloudinary, OAuth, Sentry : voir .env.example
