generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_ADMIN
  ORGANIZER_OWNER
  ORGANIZER_STAFF
}

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

// Public layout template for the event page (/e/{slug}): how candidates are
// presented. GRID = photo grid (default), LIST = rows, SPOTLIGHT = featured
// first candidate + grid for the rest.
enum EventLayout {
  GRID
  LIST
  SPOTLIGHT
}

// Habillage de la mini-plateforme publique, choisi par l'organisateur.
enum EventPageStyle {
  AFFICHE // photo de couverture en plein écran derrière le titre
  SOIREE // fond sombre, compte à rebours en grand
  BILLET // aplat de la couleur de l'événement, infos en billet
  COURONNE // composition centrée de gala, logo en médaillon, portraits encadrés
  MAGAZINE // une de magazine : couverture en demi-écran, mosaïque de candidats
  POP // aplats vifs, contours encre et ombres franches
  TERROIR // agronomie, foires, gastronomie : arche, étiquettes
  STADE // sport, tournois : bande diagonale, tableau de score, maillots
  LINEUP // concerts, talents : affiche de festival, noms en programmation
  DIPLOME // écoles, prix : cadre de certificat, sceau, portraits ronds
  MARCHE // foires agricoles, produits locaux : auvent rayé, ardoise, cagettes
  MENU // gastronomie : carte de restaurant, candidats en liste à points de conduite
  WAX // mode africaine, patrimoine : motifs de pagne à la couleur de l'événement
  CAMPUS // écoles, jeunesse : papier quadrillé, surligneur, polaroïds
  BADGE // entreprise, salons : badges de conférence, grille fine
  STORY // médias, créateurs : fond sombre, cartes verticales 9:16
  SANCTUAIRE // chorales, foi : fond nuit, halo, portraits en arche
}

// Fond des bandeaux : image de couverture (si importée) ou couleur unie.
enum EventHeroBackground {
  IMAGE
  COLOR
}

// Police des titres de la mini-plateforme.
enum EventFontStyle {
  FESTIVAL // Unbounded
  GALA // Playfair Display
  CLASSIQUE // Plus Jakarta Sans (police de la plateforme)
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PaymentPurpose {
  VOTE
  ACTIVATION
  SUBSCRIPTION
  TICKET
  ORGANIZER_VOTE_TOPUP
}

enum AuthOtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  CONTRACT_SIGNATURE
}

enum WalletLedgerKind {
  VOTE_CREDIT
  TICKET_CREDIT
  TOPUP_CREDIT
  RETENTION_DEBIT
  WITHDRAWAL_DEBIT
  ADJUSTMENT
  HELD_ALLOCATION
  HELD_RELEASE
}

/// ADR-021 : sens de l'écriture (montant toujours positif).
enum LedgerDirection {
  CREDIT
  DEBIT
}

/// ADR-021 : compartiment touché. HELD_RELEASE = transfert, écrit CREDIT WITHDRAWABLE.
enum LedgerBucket {
  HELD
  WITHDRAWABLE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum TicketTypeStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  CANCELLED
}

enum TicketStatus {
  RESERVED
  PAID
  CONFIRMED
  USED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  FEEXPAY
  KKIAPAY
  FEDAPAY
}

model Tenant {
  id               String           @id @default(cuid())
  slug             String           @unique
  displayName      String
  // Organizer-level branding defaults, inherited by events that don't override.
  logoUrl          String?
  brandColor       String?
  // Organizer-level PSP routing choice. Null = inherit platform default.
  provider         PaymentProvider?
  // Organizer payout (settlement) destination. The raw Mobile Money number is
  // NEVER stored in plaintext: payoutPhoneEnc is AES-256-GCM encrypted and
  // payoutPhoneLast4 is kept for display only (consistent with voter-phone).
  payoutNetwork    String?
  payoutPhoneEnc   String?
  payoutPhoneLast4 String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users               User[]
  events              Event[]
  auditLogs           AuditLog[]
  authSessions        AuthSession[]
  paymentTransactions PaymentTransaction[]
  invitations         Invitation[]
  notifications       Notification[]
  wallet              OrganizerWallet?
  withdrawalRequests  WithdrawalRequest[]
  commissionRates     CommissionRate[]
  contracts           EventContract[]
}

enum AuthEmailTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  photoUrl     String?
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set when the user verifies OTP after registration.
  emailVerifiedAt DateTime?

  // Platform suspension — blocks login and invalidates active sessions.
  suspendedAt     DateTime?
  suspendedReason String?

  // Privacy policy acceptance, captured once at account creation (organizer
  // onboarding). The voter journey no longer carries any consent step.
  privacyPolicyVersion String?
  privacyAcceptedAt    DateTime?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions        AuthSession[]
  notifications   Notification[]
  emailTokens     AuthEmailToken[]
  oauthAccounts   OAuthAccount[]
  otpChallenges   AuthOtpChallenge[]
  signedContracts EventContract[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model AuthOtpChallenge {
  id          String         @id @default(cuid())
  userId      String
  purpose     AuthOtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  consumedAt  DateTime?
  lastSentAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

model OrganizerWallet {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  withdrawableCfa Int      @default(0)
  heldCfa         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id           String           @id @default(cuid())
  walletId     String
  kind         WalletLedgerKind
  amountCfa    Int
  /// NULL = ligne antérieure à ADR-021 dont le sens n'a pas pu être déduit.
  direction    LedgerDirection?
  bucket       LedgerBucket?
  eventId      String?
  paymentId    String?
  withdrawalId String?
  note         String?
  createdAt    DateTime         @default(now())

  wallet OrganizerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([eventId])
}

model WithdrawalRequest {
  id                String           @id @default(cuid())
  tenantId          String
  amountCfa         Int
  status            WithdrawalStatus @default(PENDING)
  rejectReason      String?
  // Numéro de retrait figé à la demande (chiffré, 4 derniers chiffres en clair) :
  // un changement ultérieur du numéro ne détourne pas une demande en cours.
  payoutNetwork     String?
  payoutPhoneEnc    String?
  payoutPhoneLast4  String?
  processedByUserId String?
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([status, createdAt])
}

model AuthEmailToken {
  id        String                @id @default(cuid())
  userId    String
  purpose   AuthEmailTokenPurpose
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// OAuth account linking: one user may link multiple OAuth providers (e.g.
// Google + Facebook). Uniqueness is enforced per (provider, providerAccountId).
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "facebook"
  providerAccountId String // The user's unique ID from the provider
  email             String?
  displayName       String?
  photoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Event {
  id               String              @id @default(cuid())
  tenantId         String
  // Globally unique: the event is the public "platform" unit, reachable at
  // /e/{slug}. Uniqueness is enforced platform-wide, not per tenant.
  slug             String              @unique
  title            String
  status           EventStatus         @default(DRAFT)
  startsAt         DateTime
  endsAt           DateTime
  // Per-event branding. Null fields inherit from the owning organizer (Tenant).
  tagline          String?
  logoUrl          String?
  brandColor       String?
  // Public page layout template (how candidates are displayed on /e/{slug}).
  layout           EventLayout         @default(GRID)
  // Image de couverture (import Cloudinary), style de page et police des titres.
  coverUrl         String?
  pageStyle        EventPageStyle      @default(AFFICHE)
  fontStyle        EventFontStyle      @default(FESTIVAL)
  heroBackground   EventHeroBackground @default(IMAGE)
  // Per-event voting rule: if set, every vote must match this unit price.
  voteUnitPriceCfa Int?
  // Commission de la plateforme (points de base, 1 % = 100). Fixée par l'admin
  // avant la signature, puis figée par le contrat signé. Null = taux de
  // l'organisateur (historique CommissionRate) ou taux par défaut.
  commissionBps    Int?
  // Part du net mise en réserve (points de base). Figée par le contrat signé.
  heldBps          Int?
  // Per-event PSP routing override. Null = inherit the organizer's choice.
  provider         PaymentProvider?
  // Manual or auto closure timestamp (Offer 2 retention trigger).
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates  Candidate[]
  votes       Vote[]
  ticketTypes TicketType[]
  tickets     Ticket[]

  contracts EventContract[]

  @@index([tenantId, status])
  @@index([status, endsAt])
}

model TicketType {
  id           String           @id @default(cuid())
  eventId      String
  name         String
  description  String?
  priceCfa     Int
  quantity     Int
  maxPerPerson Int              @default(10)
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  status       TicketTypeStatus @default(ACTIVE)
  design       Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([eventId, name])
  @@index([eventId, status])
}

model Ticket {
  id                   String       @id @default(cuid())
  ticketTypeId         String
  eventId              String
  holderName           String?
  holderPhone          String?
  holderEmail          String?
  qrSecret             String       @unique
  status               TicketStatus @default(RESERVED)
  reservedAt           DateTime     @default(now())
  paidAt               DateTime?
  confirmedAt          DateTime?
  usedAt               DateTime?
  amountCfa            Int
  paymentTransactionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([ticketTypeId, status])
}

model Candidate {
  id        String   @id @default(cuid())
  eventId   String
  fullName  String
  photoUrl  String?
  /// Numéro d'affichage optionnel (badge). Les liens publics utilisent publicRef.
  number    Int?
  /// Identifiant public non devinable pour /e/{eventSlug}/c/{publicRef}
  publicRef String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([eventId, number])
}

model Vote {
  id                String    @id @default(cuid())
  tenantId          String
  eventId           String
  candidateId       String
  amountCfa         Int
  // Number of vote units this row represents. When voteUnitPriceCfa is set on
  // the event, votesCount = amountCfa / voteUnitPriceCfa (e.g. 10 votes at 100
  // CFA each = amountCfa 1000, votesCount 10). Without a unit price it defaults
  // to 1 (one row = one vote). Used in tally instead of COUNT(*) so that
  // multi-vote purchases are counted correctly.
  votesCount        Int       @default(1)
  // Voter identity is stored ONLY as a salted hash (for matching a voter back
  // to their vote when checking payment status) plus the last 4 digits (for
  // support/display). The raw phone number is NEVER persisted (privacy / RGPD;
  // voters have no account, so there is no deletion flow for it).
  voterPhoneHash    String?
  voterPhoneLast4   String?
  createdAt         DateTime  @default(now())
  // Payment confirmation (denormalized). Set when the linked VOTE payment is
  // confirmed SUCCEEDED by the webhook. A vote is counted in every tally ONLY
  // when paidAt is set AND cancelledAt is null. Denormalized (rather than
  // joining PaymentTransaction at read time) so tallying a high-volume event is
  // a single indexed scan instead of an unbounded `id IN (...)` set.
  paidAt            DateTime?
  // Platform-admin cancellation (god-mode). A cancelled vote is excluded from
  // every tally and revenue figure; the row is kept for audit (soft-void).
  cancelledAt       DateTime?
  cancelledReason   String?
  cancelledByUserId String?

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventId, createdAt])
  @@index([candidateId, createdAt])
  @@index([voterPhoneHash])
  @@index([eventId, cancelledAt])
  // Drives result tallies: count paid, non-cancelled votes per event/candidate.
  @@index([eventId, candidateId, paidAt, cancelledAt])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  scope       String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  requestHash String
}

model PaymentTransaction {
  id             String          @id @default(cuid())
  tenantId       String
  eventId        String
  voteId         String?         @unique
  provider       PaymentProvider
  providerRef    String?         @unique
  amountCfa      Int
  // Number of vote units this row represents. When voteUnitPriceCfa is set on
  // the event, votesCount = amountCfa / voteUnitPriceCfa (e.g. 10 votes at 100
  // CFA each = amountCfa 1000, votesCount 10). Without a unit price it defaults
  // to 1 (one row = one vote). Used in tally instead of COUNT(*) so that
  // multi-vote purchases are counted correctly.
  votesCount     Int             @default(1)
  currency       String          @default("XOF")
  status         PaymentStatus   @default(INITIATED)
  // What this payment is for: a vote, a ticket or organizer-added votes
  // (ACTIVATION and SUBSCRIPTION only remain on historical rows).
  purpose        PaymentPurpose  @default(VOTE)
  // Platform commission captured on this payment (computed at confirmation).
  commissionCfa  Int?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventId, status])
}

model ProductEvent {
  id        String   @id @default(cuid())
  name      String
  sessionId String
  userId    String?
  tenantId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String
  actorRole   UserRole
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model AuthSession {
  id                   String    @id @default(cuid())
  tenantId             String
  userId               String
  refreshTokenHash     String    @unique
  expiresAt            DateTime
  revokedAt            DateTime?
  rotatedFromSessionId String?
  userAgent            String?
  ipAddress            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt])
  @@index([userId, revokedAt])
}

// Brute-force protection state, persisted so it is shared across all API
// instances (Cloud Run scales horizontally) and survives restarts — never an
// in-memory Map. Standalone (no tenant FK): attempts may target an unknown
// tenant slug. Rows are cleared on successful login and purged by maintenance.
model LoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique // lowercased `${tenantSlug}:${email}`
  count       Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

// Global platform configuration (PLATFORM_ADMIN "god-mode" control space).
// Key/value, e.g. `commission_bps` = default commission in basis points.
model PlatformSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Encrypted platform-level secrets (FeexPay master account for activation fees).
model PlatformSecret {
  id              String   @id @default(cuid())
  key             String   @unique
  cipherText      String
  iv              String
  authTag         String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Hidden forensic vault. Every vote that a platform admin cancels or
// hard-deletes is purged from the live Vote/PaymentTransaction tables and a
// full encrypted snapshot is stored here. Read only by PLATFORM_SUPER_ADMIN
// behind a fresh-OTP gate. The "kind" field tracks why it landed here.
model VaultEntry {
  id             String   @id @default(cuid())
  kind           String
  tenantId       String
  eventId        String
  originalVoteId String
  amountCfa      Int
  occurredAt     DateTime
  actorUserId    String?
  cipherText     String
  iv             String
  authTag        String
  createdAt      DateTime @default(now())

  @@unique([originalVoteId, kind])
  @@index([tenantId, occurredAt])
  @@index([eventId])
}

// Short-lived OTP challenge: super-admin requests vault unlock, gets a 6-digit
// code by email, posts it back to obtain a 10-min vault token. The raw code is
// never stored — only sha256(code). 5 failed attempts invalidate the challenge.
model VaultUnlockChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

// Member invitation: an ORGANIZER_OWNER invites a teammate to its tenant.
// Only the SHA-256 hash of the token is stored; the raw token is delivered once.
model Invitation {
  id              String           @id @default(cuid())
  tenantId        String
  email           String
  role            UserRole
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
}

// Verrou distribué des traitements financiers périodiques (libération de la
// réserve) : deux exécutions qui se chevauchent ne traitent jamais deux fois.

model PayoutJobLock {
  name       String   @id
  acquiredAt DateTime
  acquiredBy String
  expiresAt  DateTime
}

enum NotificationType {
  PAYMENT_SUCCEEDED
  INVITATION_ACCEPTED
  EVENT_ACTIVATED
  CONTRACT_SIGNED
  COMMISSION_RATE_CHANGED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Display partners shown on the public website carousel.
model DisplayPartner {
  id         String   @id @default(cuid())
  name       String // Company/organization name
  logoUrl    String // Logo image URL
  websiteUrl String? // Optional link
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
}

// Admin access keys for programmatic API access.
model AdminApiKey {
  id              String    @id @default(cuid())
  label           String // Human-readable name
  keyHash         String    @unique // SHA-256 of the raw key
  keyPrefix       String // First 8 chars for identification
  createdByUserId String
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([revokedAt])
}

/// Image importée (logo, couverture, photo de candidat) quand Cloudinary n'est
/// pas configuré : stockée en base, servie par /uploads/files/{id}.{ext}.
/// Aucun service de fichiers externe requis.
model StoredImage {
  /// 32 caractères hexadécimaux aléatoires (non devinable).
  id        String   @id
  tenantId  String?
  mime      String
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Taux de commission négocié avec un organisateur. Historique : une ligne par
// décision de l'admin, jamais modifiée. Le taux applicable est la dernière ligne
// entrée en vigueur ; il est figé dans le contrat au moment de la signature.
model CommissionRate {
  id              String   @id @default(cuid())
  tenantId        String
  bps             Int
  effectiveFrom   DateTime
  reason          String?
  createdByUserId String
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, effectiveFrom])
}

enum ContractStatus {
  PENDING_SIGNATURE
  SIGNED
  SUPERSEDED
}

// Contrat organisateur ↔ SHADOMA pour un concours. Le contenu soumis à la
// signature est figé (snapshot + texte + empreinte SHA-256) à la génération ;
// rien n'est modifiable après la signature : un changement crée un nouveau
// contrat et l'ancien passe SUPERSEDED (jamais supprimé : preuve).
model EventContract {
  id              String         @id @default(cuid())
  eventId         String
  tenantId        String
  templateVersion String
  status          ContractStatus @default(PENDING_SIGNATURE)
  snapshot        Json
  contentText     String
  contentHash     String
  generatedAt     DateTime       @default(now())
  signedAt        DateTime?
  signedByUserId  String?
  signerName      String?
  signerEmail     String?
  signatureImage  String?
  otpVerifiedAt   DateTime?
  signerIp        String?
  signerUserAgent String?
  supersededAt    DateTime?
  // PDF signé original, conservé à l'identique et servi à chaque téléchargement.
  signedPdf       Bytes?
  signedPdfSha256 String?

  event    Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  signedBy User?  @relation(fields: [signedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, status])
  @@index([tenantId, generatedAt])
}

// Archive des lignes des fonctionnalités retirées (abonnements, formules,
// demandes de partenariat, offre partenaire, anciens versements, clés de
// paiement d'organisateur). Conservées en JSON pour l'audit, plus lues par l'app.
model LegacyArchive {
  id         String   @id @default(cuid())
  source     String
  sourceId   String
  payload    Json
  archivedAt DateTime @default(now())

  @@unique([source, sourceId])
  @@index([source])
}
